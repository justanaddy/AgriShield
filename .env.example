# ===== AgriShield Backend Configuration =====

# --- App ---
APP_NAME=AgriShield
DEBUG=true

# --- Database ---
# SQLite for local/demo. Swap to a Postgres URL for production:
# postgresql://user:password@localhost:5432/agrishield
DATABASE_URL=sqlite:///./agrishield.db

# --- Google Earth Engine ---
# Your GCP project ID registered for Earth Engine (Unpaid usage)
GEE_PROJECT_ID=agrishield-499212
# Set to "true" once you've run `earthengine authenticate --project=agrishield-499212`
# locally. If "false", the app serves cached/demo NDVI data instead.
GEE_ENABLED=false

# --- Fixed field location (Belagavi district, Karnataka - Rice/Paddy) ---
FIELD_NAME=Belagavi Demo Field
FIELD_CENTER_LAT=15.8497
FIELD_CENTER_LON=74.4977
# Approx 1 sq km field polygon around the center point, defined in gee_service.py

# --- Weather (Open-Meteo - no API key required) ---
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# --- Alerts ---
# Risk score threshold (0-1) above which an alert is triggered
ALERT_RISK_THRESHOLD=0.6
# SMS gateway (optional, e.g. Twilio) - leave blank to log alerts only
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_FROM_NUMBER=
